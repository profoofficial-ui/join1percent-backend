PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/coursellm
JWT_SECRET=coursellm_dev_jwt_secret_change_me
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@coursellm.com
ADMIN_PASSWORD=admin
ADMIN_NAME=Coursellm Admin
CLIENT_ORIGIN=http://localhost:3000

# Payments: razorpay (default) or demo
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
# Optional: Dashboard → Settings → Webhooks (payment.failed, payment.captured)
# For local testing use ngrok → https://xxxx.ngrok.io/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
